{
  "name": "aterbrukslabbet",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"prisma generate --watch\" \"next dev -p 3000\" \"prisma studio -p 4000 -b None\" \"email dev -p 5000\"",
    "build": "rimraf .next && prisma migrate deploy && prisma generate && next build && next-sitemap",
    "start": "next start",
    "launch": "pnpm build && pnpm start",
    "format:write": "prettier --write . && next lint --fix && prisma format",
    "format:check": "prettier --check . && next lint && prisma format --check",
    "db:migrate:dev": "prisma migrate dev",
    "test": "rimraf ./tests/logs && playwright test",
    "test:debug": "rimraf ./tests/logs && playwright test --headed",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/localizations": "^3.10.8",
    "@clerk/nextjs": "^6.12.9",
    "@eslint/eslintrc": "^3.3.0",
